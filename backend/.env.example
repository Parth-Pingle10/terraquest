# ==============================================================================
# TerraQuest Production Environment Baseline
# ==============================================================================

APP_ENV=production
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SHARE_TOKEN_SALT=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

DEFAULT_REGION_GRID_CELLS=100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_SHARE_PER_MINUTE=30

OLLAMA_MODEL=moondream:v2
OLLAMA_TIMEOUT_SECONDS=60
ENABLE_VISION_MODEL=false

# Optional: Only configure OLLAMA_BASE_URL if an Ollama instance is running.
# In local Docker Compose, use internal hostname: http://ollama:11434
# OLLAMA_BASE_URL=http://ollama:11434
