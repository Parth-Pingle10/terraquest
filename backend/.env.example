# ==============================================================================
# TerraQuest Backend Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_DEBUG=true
HOST=0.0.0.0
PORT=8000

# Server-side Database (Shared maps, public records, quest catalog)
# NEVER hardcode credentials in code or commit production connection strings.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=terraquest

# Security & Authentication (JWT)
# Generate a strong 32+ character random secret for production!
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Share Link Hashing Salt (used for hashing share tokens)
SHARE_TOKEN_SALT=change-this-salt-to-a-random-string-for-hash-diversity

# CORS Configuration (Comma-separated origins, never use wildcard '*' with credentials in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Local Ollama AI Provider Configuration
# Ollama must be running locally or in a configured container
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=10.0

# Exploration Percentage Default Denominator (Number of cells in default region grid)
DEFAULT_REGION_GRID_CELLS=100

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_SHARE_PER_MINUTE=30
